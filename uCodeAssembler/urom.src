XOR R2-5
Q3>A
XOR R2-4
Q2>A
XOR R2-3
Q1>A
XOR R2-2
Q0>A
XOR R2-1
R2-0>A
NOT A-0
Q>R2                    ; Save result in R2
R0-7>A                  ; Add 1 to MSB if there is a Carry
StxNoCarry.UH>UH
StxNoCarry.UL>UL           
JMP_A=0                 ; If Cin=0 then save by jumping
R3-0>A                  ; If Cin=1 then increment R3
A>Q0                    ; Compute Carrys between bits
AND R3-1
Q1>A
AND R3-2
Q2>A
AND R3-3
Q3>A
AND R3-4
Q4>A
AND R3-5
Q5>A
AND R3-6
Q6>A
AND R3-7
Q6>A
XOR R3-7
Q5>A
XOR R3-6
Q4>A
XOR R3-5
Q3>A
XOR R3-4
Q2>A
XOR R3-3
Q1>A
XOR R3-2
Q0>A
XOR R3-1
R3-0>A
NOT A-0
Q>R3                    ; increment result
StxNoCarry:
X_LSB.MSB>AH            ; READ XL
X_LSB.LSB>AL
DATA>R4
R3>AH                   ; PUT ADDRESS ON ADDRESS BUS
R2>AL
R4>DATA                 ; WRITE XL at destination address
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/0B80H               ; OP.17 ORA #**H   LOGICAL OR BETWEEN REG A AND BYTE
DATA>R0                 ; IMMEDIATE BYTE STORED INTO R0
A_REG.MSB>AH
A_REG.LSB>AL
DATA>R1                 ; REG A STORED TO R1
R0-0>A                  ; BITWISE OR, RESULT STORED IN Q
OR R1-0
R0-1>A
OR R1-1
R0-2>A
OR R1-2
R0-3>A
OR R1-3
R0-4>A
OR R1-4
R0-5>A
OR R1-5
R0-6>A
OR R1-6
R0-7>A
OR R1-7
Q>R0                    ; MOVE Q TO R0
R0>DATA                 ; STORE RESULT IN REG A
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/0C00H               ; OP.18 XORA #**H   REG A EXCLUSIVE OR immediate Byte
DATA>R0                 ; PREND DONNE
A_REG.MSB>AH
A_REG.LSB>AL
DATA>R1                 ; PREND DONNE
R0-0>A
XOR R1-0
R0-1>A
XOR R1-1
R0-2>A
XOR R1-2
R0-3>A
XOR R1-3
R0-4>A
XOR R1-4
R0-5>A
XOR R1-5
R0-6>A
XOR R1-6
R0-7>A
XOR R1-7
Q>R0
R0>DATA                 ; MET LE RESULTAT DANS REG. A
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/0C80H               ; OP.19 NOTA   NOT Logic on Register A
A_REG.MSB>AH
A_REG.LSB>AL
DATA>R0                 ; Read Register A
R0-0>A                  ; Do the NOT operation on all bits
NOT A-0
R0-1>A
NOT A-1
R0-2>A
NOT A-2
R0-3>A
NOT A-3
R0-4>A
NOT A-4
R0-5>A
NOT A-5
R0-6>A
NOT A-6
R0-7>A
NOT A-7
Q>R0
R0>DATA                 ; Put result in Register A
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/0D00H               ; OP.1A TEQX 0x****   COMPARE X to immediate value
DATA>R0                 ; Read MSB Data       UPDATE STATUS E (EQUAL) TO 1 WHEN EQUAL
X_MSB.MSB>AH            ; Read XH             ELSE E = 0.
X_MSB.LSB>AL
DATA>R1
R0-0>A                  ; XNOR between each bits on MSB
XNOR R1-0
R0-1>A
XNOR R1-1
R0-2>A
XNOR R1-2
R0-3>A
XNOR R1-3
R0-4>A
XNOR R1-4
R0-5>A
XNOR R1-5
R0-6>A
XNOR R1-6
R0-7>A
XNOR R1-7
Q>R0                    ; result in R0
R0-0>A                  ; AND between each bits in R0
AND R0-1
Q1>A
AND R0-2
Q2>A
AND R0-3
Q3>A
AND R0-4
Q4>A
AND R0-5
Q5>A
AND R0-6
Q6>A
AND R0-7
Q7>A                    ; Equal status in A
TeqXCompareLsb.UH>UH    ; If MSB identical we need to continue to verify LSB
TeqXCompareLsb.UL>UL
JMP_A=1
00H>R0                  ; MSB is different, force '0' in Equal Status bit position <0>
E_FLAG.MSB>AH
E_FLAG.LSB>AL
R0>DATA
IncIP.UH>UH             ; skip LSB | ADD. ROUTINE INCREMENT IP
IncIP.UL>UL             ;          |
LdxDirectDone.UH>R4     ;  IP+1>IP | ADD. RETURN R4:MSB R5:LSB
LdxDirectDone.UL>R5     ;          |
JMP                     ;          | JMP TO ROUTINE
LdxDirectDone:
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP
TeqXCompareLsb:
IncIP.UH>UH             ; Continue compare with the LSB
IncIP.UL>UL             ;          | ADD. ROUTINE INCREMENT IP
LdxCarryDone.UH>R4      ;  IP+1>IP | ADD. RETURN
LdxCarryDone.UL>R5      ;  IP>ADD  | JMP TO ROUTINE
JMP                     ;
LdxCarryDone:
DATA>R0                 ; Read LSB Data
X_LSB.MSB>AH            ; Read XL
X_LSB.LSB>AL
DATA>R1
R0-0>A                  ; XNOR between each bits on MSB
XNOR R1-0
R0-1>A
XNOR R1-1
R0-2>A
XNOR R1-2
R0-3>A
XNOR R1-3
R0-4>A
XNOR R1-4
R0-5>A
XNOR R1-5
R0-6>A
XNOR R1-6
R0-7>A
XNOR R1-7
Q>R0                    ; result in R0
R0-0>A                  ; AND between each bits in R0
AND R0-1
Q1>A
AND R0-2
Q2>A
AND R0-3
Q3>A
AND R0-4
Q4>A
AND R0-5
Q5>A
AND R0-6
Q6>A
AND R0-7
Q7>A                    ; Equal status in A
TeqXEqual.UH>UH         ; If LSB identical go set the equal flag
TeqXEqual.UL>UL
JMP_A=1
00H>R0                  ; Else it's different clear Equal Status bit position <0>
E_FLAG.MSB>AH
E_FLAG.LSB>AL
R0>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP
TeqXEqual:
01H>R0                  ; MSB and LSB are identical the set '1' in Equal Status bit position <0>
E_FLAG.MSB>AH
E_FLAG.LSB>AL
R0>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/0D80H               ; OP.1B LDX s.**H    LDX from specifyed 8 bit address
DATA>R0                 ; Read LSB Address
