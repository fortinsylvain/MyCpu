DecaNotZero.UL>UL
R0-0>A                  
JMP_A=1
R0-1>A
JMP_A=1
R0-2>A
JMP_A=1
R0-3>A
JMP_A=1
R0-4>A
JMP_A=1
R0-5>A
JMP_A=1
R0-6>A
JMP_A=1
R0-7>A
JMP_A=1
01H>R1                  ; All bits are '0', Set E Status
E_FLAG.LSB>AL
R1>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP
DecaNotZero:
00H>R1                  ; Clear E Status
E_FLAG.LSB>AL
R1>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
