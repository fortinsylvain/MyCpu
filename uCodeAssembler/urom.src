X_MSB.LSB>AL
R2>DATA                 ; Store in X MSB
R0-0>A                  ; Point to next address (8 bit only range)
A>Q0                    ; Compute Carry
AND R0-1
Q1>A
AND R0-2
Q2>A
AND R0-3
Q3>A
AND R0-4
Q4>A
AND R0-5
Q5>A
AND R0-6
Q6>A
AND R0-7
Q>R1                    ; Save Cout in R1-7
Q6>A
XOR R0-7
Q5>A
XOR R0-6
Q4>A
XOR R0-5
Q3>A
XOR R0-4
Q2>A
XOR R0-3
Q1>A
XOR R0-2
Q0>A
XOR R0-1
R0-0>A
NOT A-0
Q>R0                    ; Save increment result in R0
00H>AH                  ; Set address to source
R0>AL
DATA>R2
X_LSB.MSB>AH
X_LSB.LSB>AL
R2>DATA                 ; Store in X LSB
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/0E00H               ; OP.1C LDA (****H,X) LDA indexed indirect addressing
DATA>R0                 ; Read MSB Operand
TEMP0.MSB>AH            ; store in TEMP0
TEMP0.LSB>AL
R0>DATA                 
IncIP.UH>UH             ;          | ADD. ROUTINE INCREMENT IP
IncIP.UL>UL             ;          |
LdaIdxOpLsb.UH>R4       ;  IP+1>IP | ADD. RETURN
LdaIdxOpLsb.UL>R5       ;  IP>ADD  |
JMP                     ;          | JMP TO ROUTINE
LdaIdxOpLsb:
DATA>R0                 ; Read LSB Operand
X_LSB.MSB>AH            ; Read XL
X_LSB.LSB>AL
DATA>R1
00H>R2                  ; Clear carry in
Add.UH>UH               ; Cin:R2-0  | ADD. ROUTINE
Add.UL>UL               ; R0+R1>R0  |
LdaIdxLowRet.UH>R6      ; Cout>R2-0 | RETURN ADDRESS
LdaIdxLowRet.UL>R7      ; keep carry in R2 it will be used later
JMP
LdaIdxLowRet:
TEMP1.LSB>AL            ; store LSB address summ in TEMP1
R0>DATA                 
TEMP0.LSB>AL            ; Load MSB Operand from TEMP0
DATA>R0
X_MSB.MSB>AH            ; Read XH
X_MSB.LSB>AL                  
DATA>R1
Add.UH>UH               ; Cin:R2-0  | ADD. ROUTINE
Add.UL>UL               ; R0+R1>R0  |
LdaIdxHighRet.UH>R6     ; Cout>R2-0 | RETURN ADDRESS
LdaIdxHighRet.UL>R7
JMP
LdaIdxHighRet:
TEMP1.LSB>AL            ; MSB Address is in R0
DATA>R1                 ; LSB Address is in TEMP1 put it in R1
R0>AH                   ; Read Data
R1>AL
DATA>R0                 
A_REG.MSB>AH            ; Store in Register A
A_REG.LSB>AL
R0>DATA                 
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/0E80H               ; OP.1D STA (****H,X) STA indexed indirect addressing
DATA>R0                 ; Read MSB Operand
TEMP0.MSB>AH            ; store in TEMP0
TEMP0.LSB>AL
R0>DATA                 
IncIP.UH>UH             ;          | ADD. ROUTINE INCREMENT IP
IncIP.UL>UL             ;          |
StaIdxOpLsb.UH>R4       ;  IP+1>IP | ADD. RETURN
StaIdxOpLsb.UL>R5       ;  IP>ADD  |
JMP                     ;          | JMP TO ROUTINE
