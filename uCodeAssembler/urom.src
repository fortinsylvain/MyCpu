XOR R0-6
Q4>A
XOR R0-5
Q3>A
XOR R0-4
Q2>A
XOR R0-3
Q1>A
XOR R0-2
Q0>A
XOR R0-1
R0-0>A
NOT A-0
Q>R0                    ; Save temporary result into R0
R0-0>A                  ; NOT R0 > R0
NOT A-0
R0-1>A
NOT A-1
R0-2>A
NOT A-2
R0-3>A
NOT A-3
R0-4>A
NOT A-4
R0-5>A
NOT A-5
R0-6>A
NOT A-6
R0-7>A
NOT A-7
Q>R0
R6>UH                   ; Return to calling microprogram
R7>UL
JMP                     ; ******************************************************
ORG/1D80H               ; 3B00H  ROUTINE   * IP+1>IP   IP>ADD.                 *
IncIP:
IPL.MSB>AH              ;        READ IPL  * RETURN  R4:MSB ADD. R5:LSB ADD.   *
IPL.LSB>AL              ;        PUT IN R0 *************************************
DATA>R0                 ; INCREMENT (COUT R1-7) R0+1>R0
R0-0>A
IncIpLoNoC.UH>UH   ; Fast track if IPL<0> is 0
IncIpLoNoC.UL>UL
JMP_A=0
A>Q0                    ; Compute the Carrys
AND R0-1
Q1>A
AND R0-2
Q2>A
AND R0-3
Q3>A
AND R0-4
Q4>A
AND R0-5
Q5>A
AND R0-6
Q6>A
AND R0-7
Q>R1                    ; Savec Cout in R1-7
Q6>A
XOR R0-7
Q5>A
XOR R0-6
Q4>A
XOR R0-5
Q3>A
XOR R0-4
Q2>A
XOR R0-3
Q1>A
XOR R0-2
Q0>A
XOR R0-1
R0-0>A
NOT A-0
Q>R0                    ; Save result in R0
IPL.MSB>AH              ; Save increment result in IPL
IPL.LSB>AL
R0>DATA
IPH.LSB>AL              ; Read IPH
DATA>R0
R1-7>A                  ; Add 1 to IPH if there is a Carry R0 + (R1-7) > R
IncIpHiNoC.UH>UH
IncIpHiNoC.UL>UL           
JMP_A=0                 ; If Cin=0 then save by jumping
R0-0>A                  ; If not we increment R0 containing IPH
A>Q0                    ; Compute Carrys between bits
AND R0-1
Q1>A
AND R0-2
Q2>A
AND R0-3
Q3>A
AND R0-4
Q4>A
AND R0-5
Q5>A
AND R0-6
Q6>A
AND R0-7
Q6>A
XOR R0-7
Q5>A
XOR R0-6
Q4>A
XOR R0-5
Q3>A
XOR R0-4
Q2>A
XOR R0-3
Q1>A
XOR R0-2
Q0>A
XOR R0-1
R0-0>A
NOT A-0
Q>R0                    ; Increment result in R0
IncIpHiNoC:
IPH.MSB>AH              ; Save new IPH value
IPH.LSB>AL            
R0>DATA
IPH.MSB>AH              ; Read IPH  << JUMP DESTINATION when no increment on IPH >>
IPH.LSB>AL
DATA>R0
IPL.LSB>AL              ; Read IPL
DATA>R1
R0>AH                   ; Put IP in Address Bus
R1>AL
R4>UH                   ; Return to calling routine
R5>UL
JMP
IncIpLoNoC:
NOT A-0                 ; <JUMP Fast track> just set IP<0> to 1.
00H>R1
R1-0>A
OR R0-1
OR R0-2
OR R0-3
OR R0-4
OR R0-5
OR R0-6
OR R0-7
Q>R1                    ; New IPL in R1
IPL.MSB>AH              ; Store IPL
IPL.LSB>AL
R1>DATA
IPH.LSB>AL              ; Read IPH and out in R0
DATA>R0
R0>AH                   ; Put IP on Adress bus
R1>AL
R4>UH                   ; Return to calling routine
R5>UL
JMP                     ; *************************************************
ORG/1E00H               ; 3C00H  INCREMENT IP
IncrementIp:
IPL.MSB>AH              ;        Return  R4:MSB R5:LSB
IPL.LSB>AL              ; Read IPL
DATA>R0                 
IncrementR0.UH>UH       ; Address Increment routine
IncrementR0.UL>UL
IncIpLowRet.UH>R6       ; Address Return
IncIpLowRet.UL>R7
JMP
IncIpLowRet:
IPL.MSB>AH              ; Result in IPL
IPL.LSB>AL
R0>DATA
IPH.LSB>AL              ; Read IPH
DATA>R0
AddCarry.UH>UH          ; Address routine to Add Carry
AddCarry.UL>UL
IncIpHighRet.UH>R6      ; Return Address
IncIpHighRet.UL>R7
JMP                     ; Call routine
IncIpHighRet:
IPH.MSB>AH              ; Save result Add Carry
IPH.LSB>AL
R0>DATA                 
R4>UH                   ; Return Address
R5>UL
JMP                     ; ***************************************************
ORG/1E80H               ; 3D00H  ADD CARRY   R0+(R1-7)>R0  Cout:R1-7
AddCarry:
R1-7>A                  ;                    Return R6:MSB R7:LSB  
AddCarryNoC.UH>UH
AddCarryNoC.UL>UL
JMP_A=0                 ; If Cin=0 then jump to end to go to return 
R0-0>A                  ; Increment R0
A>Q0                    ; Compute Carry
AND R0-1
Q1>A
AND R0-2
Q2>A
AND R0-3
Q3>A
AND R0-4
Q4>A
AND R0-5
Q5>A
AND R0-6
Q6>A
AND R0-7
Q>R1                    ; Save Cout in R1-7
Q6>A
XOR R0-7
Q5>A
XOR R0-6
Q4>A
XOR R0-5
Q3>A
XOR R0-4
Q2>A
XOR R0-3
Q1>A
XOR R0-2
Q0>A
XOR R0-1
R0-0>A
NOT A-0
Q>R0                    ; Save result in R0
R6>UH                   ; Return Address MSB
R7>UL                   ;                LSB
JMP                     ; End of incrementation
AddCarryNoC:
00H>R1                  ; Come here if no incrementation (Cout=0)
R6>UH                   ; Return Address MSB
R7>UL                   ;                LSB
JMP                     ; ***************************************************
