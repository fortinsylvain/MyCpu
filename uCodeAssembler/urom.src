DATA>R0
DecRoutine.UH>UH        ;          | ADD. Routine R0-1>R0
DecRoutine.UL>UL        ; SP-1     |
PopaReturn.UH>R6        ;          | ADD. return
PopaReturn.UL>R7        ; Decrementing the Stack Pointer Register
JMP
PopaReturn:
R0>DATA                 ; Store result in SP
00H>AH                  ; Read byte pointed by SP and put in register A
R0>AL
DATA>R1
A_REG.MSB>AH            ; Store in A Register
A_REG.LSB>AL
R1>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/1300H               ; OP.26 CLRA  Clear register A, E flag set
00H>R0
A_REG.MSB>AH            ; Store in A Register
A_REG.LSB>AL
R0>DATA
01H>R0
E_FLAG.LSB>AL           ; Set E flag
R0>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/1380H               ; OP.27 LDA (SP-0x**) Load A register from stack with offset, (SP-Offset) -> A 
DATA>R1                 ; Read Offset, 2s complement precomputed -> R1
SP.MSB>AH               ; Read Stack Pointer Register -> R0
SP.LSB>AL
DATA>R0
00H>R2                  ; Clean Cin
Add.UH>UH               ; R2<0> Cin | ADD. ROUTINE
Add.UL>UL               ; R0+R1>R0  | 
LdaStackReturn.UH>R6    ; Cout>R2-0 | RETURN ADDRESS
LdaStackReturn.UL>R7
JMP
LdaStackReturn:
00H>AH                  ; Read pointed byte (SP-Offset)
R0>AL
DATA>R0
A_REG.MSB>AH            ; Store in A Register
A_REG.LSB>AL
R0>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/1400H               ; OP.28 ADCA ****H  A + C + BYTE AT ADDRESS, C UPDATE
DATA>R2                 ; Read MSB Address (MSB->R2)
IncIP.UH>UH             ;          | ADD. ROUTINE INCREMENT IP
IncIP.UL>UL             ;          |
AdcaDirOpLsb.UH>R4      ;  IP+1>IP | ADD. RETURN
AdcaDirOpLsb.UL>R5      ;  IP>ADD  |
JMP                     ;          | JMP TO ROUTINE
AdcaDirOpLsb:
DATA>R3                 ; Read LSB Address (LSB->R3)
R2>AH                   ; Put address on the address bus
R3>AL
DATA>R0                 ; Read the memory operand
A_REG.MSB>AH            ; READ REG A
A_REG.LSB>AL   
DATA>R1
C_FLAG.MSB>AH           ; READ CARRY IN
C_FLAG.LSB>AL
DATA>R2
Add.UH>UH               ;           | ADD. ROUTINE
Add.UL>UL               ; R0+R1>R0  |
AdcaDirRet.UH>R6        ; Cout>R2-0 | RETURN ADDRESS
AdcaDirRet.UL>R7
JMP
AdcaDirRet:
A_REG.MSB>AH            ; PUT SUMM IN REG. A
A_REG.LSB>AL
R0>DATA
C_FLAG.LSB>AL           ; PUT Cout IN REG C (Carry)
R2>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/1480H               ; OP.29 ADDA ****H  ADD A WITH BYTE AT ADDRESS, C UPDATE
DATA>R2                 ; READ MSB ADDRESS
IncIP.UH>UH             ;          | ADD. ROUTINE INCREMENT IP
IncIP.UL>UL             ;          |
AddaDirOpLsb.UH>R4      ;  IP+1>IP | ADD. RETURN
AddaDirOpLsb.UL>R5      ;  IP>ADD  |
JMP                     ;          | JMP TO ROUTINE
AddaDirOpLsb:
DATA>R3                 ; READ LSB ADDRESS
R2>AH                   ; PUT ADDRESS ON ADDRESS BUS
R3>AL
DATA>R0                 ; READ POINTED BYTE
A_REG.MSB>AH            ; READ REG A
A_REG.LSB>AL   
DATA>R1
00H>R2                  ; Put Cin=0
Add.UH>UH               ;           | ADD. ROUTINE
Add.UL>UL               ; R0+R1>R0  |
AddaDirRet.UH>R6        ; Cout>R2-0 | RETURN ADDRESS
AddaDirRet.UL>R7
JMP
AddaDirRet:
A_REG.MSB>AH            ; PUT SUMM IN REG. A
A_REG.LSB>AL
R0>DATA
C_FLAG.LSB>AL           ; PUT Cout IN REG C (Carry)
R2>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/1500H               ; OP.2A LDA ****H  LOAD A WITH BYTE AT ADDRESS
DATA>R2                 ; READ MSB ADDRESS
IncIP.UH>UH             ;          | ADD. ROUTINE INCREMENT IP
IncIP.UL>UL             ;          |
LdaDirOpLsb.UH>R4       ;  IP+1>IP | ADD. RETURN
LdaDirOpLsb.UL>R5       ;  IP>ADD  |
JMP                     ;          | JMP TO ROUTINE
LdaDirOpLsb:
DATA>R3                 ; READ LSB ADDRESS
R2>AH                   ; PUT ADDRESS ON ADDRESS BUS
R3>AL
DATA>R0                 ; READ POINTED BYTE
A_REG.MSB>AH            ; PUT IN REGISTER A
A_REG.LSB>AL
R0>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/1580H               ; OP.2B JNEQ ****H  JUMP IF STATUS E (EQUAL) = 1
E_FLAG.MSB>AH           ; LIS BIT E ET MET DANS ENTREE A DE L'ALU.
E_FLAG.LSB>AL
DATA>R0
R0-0>A
JneqTaken.UH>UH         ; ADDRESSE DU SAUT DANS LE UPROG. SI E=0
JneqTaken.UL>UL
JMP_A=0
IncrementIp.UH>UH       ; ON PASSE SI ON A EGALITE  E=1    | ADD. ROUTINE
IncrementIp.UL>UL       ;                          IP+1>IP |
NextOpExec.UH>R4        ;                                  | ADD. RETOUR
NextOpExec.UL>R5        ;                                  | PROCHAIN OP.
JMP
JneqTaken:
IPH.MSB>AH              ; ARRIVAL WHEN E=0, READ IPH
IPH.LSB>AL
DATA>R0
IPL.LSB>AL              ; READ IPL
DATA>R1                          
R0>AH                   ; WRITE IPH:IPL IN AH:AL
R1>AL
DATA>R2                 ; GET MSB OF JUMP ADDRESS
IncIP.UH>UH             ;          | ADD. ROUTINE
IncIP.UL>UL             ;  IP+1>IP |
JneqTargetLsb.UH>R4     ;  IP>ADD  | ADD. RETOUR
JneqTargetLsb.UL>R5     ;          |
JMP
JneqTargetLsb:
DATA>R3                 ; GET LSB OF JUMP ADDRESS
IPH.MSB>AH              ; MET MSB ADD. DE SAUT DANS IPH
IPH.LSB>AL
R2>DATA
IPL.LSB>AL              ; MET LSB ADD. DE SAUT DANS IPL
R3>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute ( SAUT DU A L'INEGALITE )
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/1600H               ; OP.2C JEQ ****H  JUMP IF STATUS E (EQUAL) = 1
E_FLAG.MSB>AH           ; LIS BIT E ET MET DANS ENTREE A DE L'ALU.
E_FLAG.LSB>AL
DATA>R0
R0-0>A
JeqNotTaken.UH>UH       ; ADDRESSE DU SAUT DANS LE UPROG. SI E=0
JeqNotTaken.UL>UL
JMP_A=0
IPH.LSB>AL              ; ICI ON A E=1 ALORS ON PREND L'ADDRESSE  MSB ADD.
DATA>R2                 ; IPH > R2
IPL.LSB>AL
DATA>R3                 ; IPL > R3
R2>AH                   ; IP > ADD
R3>AL
DATA>R2                 ; TAKE MSB ADD WHERE TO JUMP AND PUT IN R2
IncIP.UH>UH             ;          | ADD. ROUTINE
IncIP.UL>UL             ;  IP+1>IP |
JeqTargetLsb.UH>R4      ;  IP>ADD  | ADD. RETOUR
JeqTargetLsb.UL>R5      ;          |
JMP
JeqTargetLsb:
DATA>R3                 ; PREND LSB WHERE TO JUMP AND PUT IN R3
IPH.MSB>AH              ; MET MSB ADD. DE SAUT DANS IPH
IPH.LSB>AL
R2>DATA
IPL.LSB>AL              ; MET LSB ADD. DE SAUT DANS IPL
R3>DATA
OpExec.UH>UH            ; EXECUTE OP. POINTEE ( SAUT DU A L'EGALITE )
OpExec.UL>UL
JMP
JeqNotTaken:
IncrementIp.UH>UH       ; POINT ARRIVE SI INEGALITE E=0     | ADD. ROUTINE
IncrementIp.UL>UL       ;                           IP+1>IP |
NextOpExec.UH>R4        ;                                   | ADD. RETOUR
NextOpExec.UL>R5        ;                                   | PROCHAIN OP.
JMP                     ; ***************************************************
ORG/1680H               ; OP.2D CMPA #**H Compare A with immediate value (A-imm)
DATA>R1                 ; Imm->R1                               E and C updated
A_REG.MSB>AH            ; Read Reg A                   A - imm = A + (~imm) + 1
A_REG.LSB>AL
DATA>R0                 ; A -> R0
00H>R2                  ; Two's complement of immediate (R1 = ~R1)
R2-0>A                  ; Clear ALU A
XNOR R1-0
XNOR R1-1
XNOR R1-2
XNOR R1-3
XNOR R1-4
XNOR R1-5
XNOR R1-6
XNOR R1-7
Q>R1
01H>R2                  ; R2-0 used as Cin
Add.UH>UH               ; Cin:R2-0  | ADD. ROUTINE
Add.UL>UL               ; R0+R1>R0  |
CmpaImmRet.UH>R6        ; Cout>R2-0 | RETURN ADDRESS
CmpaImmRet.UL>R7        ; keep carry out R2
JMP
CmpaImmRet:
C_FLAG.MSB>AH           ; Save C
C_FLAG.LSB>AL
R2>DATA
R0-0>A                  ; Check R0 equal 0
OR R0-1
Q1>A
OR R0-2
Q2>A
OR R0-3
Q3>A
OR R0-4
Q4>A
OR R0-5
Q5>A
OR R0-6
Q6>A
OR R0-7
Q7>A
CmpaImmNotEq.UH>UH
CmpaImmNotEq.UL>UL
JMP_A=1                 ; if any bit is 1 jump
01H>R1                  ; E=1, Result is equal to 0
E_FLAG.LSB>AL   
R1>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP
CmpaImmNotEq:
00H>R1                  ; E=0, Result is not 0
E_FLAG.LSB>AL   
R1>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/1700H               ; OP.2E ADCA #**H   ACCA+M+C>ACCA     C UPDATED
DATA>R0                 ; READ IMMEDIATE VALUE
A_REG.MSB>AH            ; READ REGISTER A
A_REG.LSB>AL
DATA>R1
C_FLAG.MSB>AH           ; READ CARRY IN
C_FLAG.LSB>AL
DATA>R2
Add.UH>UH               ;           | ADD. ROUTINE
Add.UL>UL               ; R0+R1>R0  |
AdcaImmRet.UH>R6        ; Cout>R2-0 | ADD. RETOUR
AdcaImmRet.UL>R7        ;           |
JMP                     ;           |
AdcaImmRet:
A_REG.MSB>AH            ; MET SOMME DANS REG. A
A_REG.LSB>AL
R0>DATA
C_FLAG.LSB>AL           ; MET Cout DANS REG C (Carry)
R2>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/1780H               ; OP.2F ADDA #**H   ACCA+M>ACCA     C UPDATED
DATA>R0                 ; READ IMMEDIATE BYTE FOLLOWING OP CODE
A_REG.MSB>AH            ; READ REGISTER A
A_REG.LSB>AL
DATA>R1
00H>R2                  ; FORCED Cin=0
Add.UH>UH               ;           | ROUTINE ADDRESS
Add.UL>UL               ; R0+R1>R0  |
AddaImmRet.UH>R6        ; Cout>R2-0 | RETURN ADDRESS
AddaImmRet.UL>R7        ;           |
JMP                     ;           |
AddaImmRet:
A_REG.MSB>AH            ; PUT SUMM INTO A REGISTER
A_REG.LSB>AL
R0>DATA
C_FLAG.LSB>AL           ; PUT Cout INTO C (Carry) REGISTER
R2>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/1800H               ; OP.30 LDA #**H  LOAD IMMEDIATE VALUE IN REGISTER A
DATA>R0                 ; READ HEX VALUE TO LOAD
A_REG.MSB>AH            ; PUT VALUE AT REGISTER A ADDRESS
A_REG.LSB>AL
R0>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/1880H               ; OP.31 STA ****H   STORE REG.A TO ADDRESSE
DATA>R2                 ; PREND MSB ADD. DE STOCKAGE DE A
IncIP.UH>UH             ;          | ADD. ROUTINE
IncIP.UL>UL             ;  IP+1>IP |
StaDirOpLsb.UH>R4       ;  IP>ADD  | ADD. RETOUR
StaDirOpLsb.UL>R5       ;          |
JMP
StaDirOpLsb:
DATA>R3                 ; PREND LSB ADD. DE STOCKAGE DE A
A_REG.MSB>AH            ; LIS LE REGISTRE A
A_REG.LSB>AL
DATA>R0
R2>AH                   ; MET L'ADDRESSE DE DESTINATION SUR BUS ADDRESSE
R3>AL
R0>DATA                 ; STOCKE REGISTRE A A L'ADDRESSE POINTEE
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/1900H               ; OP.32 JMP ****H JUMP INCONDITIONAL TO ADDRESS
DATA>R2                 ; TALE MSB ADDRESS 
IncIP.UH>UH             ;          | ADD. ROUTINE
IncIP.UL>UL             ;  IP+1>IP |
JmpTargetLsb.UH>R4      ;  IP>ADD  | ADD. RETURN
JmpTargetLsb.UL>R5      ;          |
JMP
JmpTargetLsb:
DATA>R3                 ; PREND LSB ADD. DE SAUT INCONDITIONNEL
IPH.MSB>AH              ; MET MSB ADD. DE SAUT DANS IPH
IPH.LSB>AL
R2>DATA
IPL.LSB>AL              ; MET LSB ADD. DE SAUT DANS IPL
R3>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; **************************************************
ORG/1980H               ; OP.33 ANDA #**H  REGISTER A AND LOGICAL IMMEDIATE 
DATA>R0                 ; TAKE IMMEDIATE BYTE AND STORE IN R0
A_REG.MSB>AH
A_REG.LSB>AL
DATA>R1                 ; READ A REGISTER AND STORE IN R1
R0-0>A                  ; DO BITWISE AND BBETWEEN R0 AND R1
AND R1-0                ; BUILD RESULT IN Q
R0-1>A
AND R1-1
R0-2>A
AND R1-2
R0-3>A
AND R1-3
R0-4>A
AND R1-4
R0-5>A
AND R1-5
R0-6>A
AND R1-6
R0-7>A
AND R1-7
Q>R0                    ; MOVE Q TO R0
R0>DATA                 ; STORE R0 INTO REGISTER A
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/1A00H               ; OP.34 LDX ****H    LDX from specifyed 16 bit address
DATA>R0                 ; Read MSB Operand
TEMP0.MSB>AH            ; store in TEMP0
TEMP0.LSB>AL
R0>DATA                 
IncIP.UH>UH             ;          | ADD. ROUTINE INCREMENT IP
IncIP.UL>UL             ;          |
LdxDirOpLsb.UH>R4       ;  IP+1>IP | ADD. RETURN
LdxDirOpLsb.UL>R5       ;  IP>ADD  |
JMP                     ;          | JMP TO ROUTINE
LdxDirOpLsb:
DATA>R0                 ; Read LSB Operand put in R0
TEMP1.MSB>AH            ; store in TEMP1
TEMP1.LSB>AL
R0>DATA                 
TEMP0.LSB>AL
DATA>R1                 ; MSB in R1
R0>AL
R1>AH
DATA>R2                 ; Read new X MSB value to be loaded
X_MSB.MSB>AH            ; Store into X MSB register
X_MSB.LSB>AL
R2>DATA
R0-0>A                  ; Point to next address Increment R0
A>Q0                    ; Compute Carry
AND R0-1
Q1>A
AND R0-2
Q2>A
AND R0-3
Q3>A
AND R0-4
Q4>A
AND R0-5
Q5>A
AND R0-6
Q6>A
AND R0-7
Q>R1                    ; Save Cout in R1-7
Q6>A
XOR R0-7
Q5>A
XOR R0-6
Q4>A
XOR R0-5
Q3>A
XOR R0-4
Q2>A
XOR R0-3
Q1>A
XOR R0-2
Q0>A
XOR R0-1
R0-0>A
NOT A-0
Q>R0                    ; Save increment result in R0
TEMP1.MSB>AH            ; store LSB increment result in TEMP1
TEMP1.LSB>AL
R0>DATA
R1-7>A                  ; Check if carry on MSB
LdxDirectCarry.UH>UH
LdxDirectCarry.UL>UL
JMP_A=1                 ; if carry bit is 1 jump
TEMP0.MSB>AH            ; No carry
TEMP0.LSB>AL            ; move TEMP0 containing MSB Add to R0
DATA>R0
TEMP1.LSB>AL            ; move TEMP1 containing LSB Add to R1
DATA>R1
R0>AH                   ; Put on address bus
R1>AL
DATA>R0                 ; Get new X LSB value
X_LSB.MSB>AH            ; Store in X LSB register
X_LSB.LSB>AL
R0>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP
LdxDirectCarry:
TEMP0.MSB>AH            ; <<JUMP>> Carry bit set 
TEMP0.LSB>AL            ; move TEMP0 containing MSB Add to R0
DATA>R0
R0-0>A                  ; Increment address MSB
A>Q0                    ; Compute Carry
AND R0-1
Q1>A
AND R0-2
Q2>A
AND R0-3
Q3>A
AND R0-4
Q4>A
AND R0-5
Q5>A
AND R0-6
Q6>A
AND R0-7
Q>R1                    ; Save Cout in R1-7
Q6>A
XOR R0-7
Q5>A
XOR R0-6
Q4>A
XOR R0-5
Q3>A
XOR R0-4
Q2>A
XOR R0-3
Q1>A
XOR R0-2
Q0>A
XOR R0-1
R0-0>A
NOT A-0
Q>R0                    ; Save MSB increment result in R0
TEMP1.MSB>AH                  
TEMP1.LSB>AL            ; move TEMP1 containing LSB Add to R1
DATA>R1
R0>AH                   ; Put on address bus
R1>AL
DATA>R0                 ; Get new X LSB value
X_LSB.MSB>AH            ; Store in X LSB register
X_LSB.LSB>AL
R0>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/1A80H               ; OP.35 JRNE Jump Relative if not Equal (Condition E = 0)
E_FLAG.MSB>AH           ; Read E bit and put in A ALU input
E_FLAG.LSB>AL
DATA>R0
R0-0>A
JrneTaken.UH>UH         ; if E = 0 then prepare the jump JRA
JrneTaken.UL>UL
JMP_A=0
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     
JrneTaken:
IPH.LSB>AL              ; Put IP on Address Bus
DATA>R0
IPL.LSB>AL
DATA>R1
R0>AH
R1>AL
Jra.UH>UH               ; Do the JRA
Jra.UL>UL
JMP                     ; ***************************************************
ORG/1B00H               ; OP.36 JRE Jump Relative if Equal (Condition E = 1)
E_FLAG.MSB>AH           ; Read E bit and put in A ALU input
E_FLAG.LSB>AL
DATA>R0
R0-0>A
JreTaken.UH>UH          ; if E = 1 then prepare the jump JRA
JreTaken.UL>UL
JMP_A=1
NextOpExec.UH>UH        ; NEXT OP.
NextOpExec.UL>UL
JMP
JreTaken:
IPH.LSB>AL              ; Put IP on Address Bus
DATA>R0
IPL.LSB>AL
DATA>R1
R0>AH
R1>AL
Jra.UH>UH               ; Do the JRA
Jra.UL>UL
JMP                     ; ***************************************************
ORG/1B80H               ; OP.37
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/1C00H               ; OP.38
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/1C80H               ; 3B80H  SUBTRACT R0-R1>R0  Cin:R2-0  Cout:R2-0
Subtract:
R0-0>A                  ;                 Return R6:MSB R7:LSB
OR R1-0                 ;                 Using R3, R4, R5
R0-1>A
OR R1-1
R0-2>A
OR R1-2
R0-3>A
OR R1-3
R0-4>A
OR R1-4
R0-5>A
OR R1-5
R0-6>A
OR R1-6
R0-7>A
OR R1-7
Q>R3
R0-0>A                  ; R0 AND R1 > R4
AND R1-0
R0-1>A
AND R1-1
R0-2>A
AND R1-2
R0-3>A
AND R1-3
R0-4>A
AND R1-4
R0-5>A
AND R1-5
R0-6>A
AND R1-6
R0-7>A
AND R1-7
Q>R4
R2-0>A                  ; Process Carry  Cin:R2-0
AND R3-0
Q0>A
OR R4-0
Q0>A
AND R3-1
Q1>A
OR R4-1
Q1>A
AND R3-2
Q2>A
OR R4-2
Q2>A
AND R3-3
Q3>A
OR R4-3
Q3>A
AND R3-4
Q4>A
OR R4-4
Q4>A
AND R3-5
Q5>A
OR R4-5
Q5>A
AND R3-6
Q6>A
OR R4-6
Q6>A
AND R3-7
Q7>A
OR R4-7
Q>R5
R2-0>A                  ; R0 XOR R1 XOR COUTn
XOR R0-0
Q0>A
XOR R1-0
R5-0>A
XOR R0-1
Q1>A
XOR R1-1
R5-1>A
XOR R0-2
Q2>A
XOR R1-2
R5-2>A
XOR R0-3
Q3>A
XOR R1-3
R5-3>A
XOR R0-4
Q4>A
XOR R1-4
R5-4>A
XOR R0-5
Q5>A
XOR R1-5
R5-5>A
XOR R0-6
Q6>A
XOR R1-6
R5-6>A
XOR R0-7
Q7>A
XOR R1-7
Q>R0                    ; Save final result in R0
R5-7>A
A>Q0                    ; Store Carry in Q Bit<0>
00H>R1
R1-0>A
A>Q1                    ; Set Q <7:1> to 0
A>Q2                    ; To have a clean carry register
A>Q3
A>Q4
A>Q5
A>Q6
A>Q7
Q>R2                    ; Save Carry
R6>UH                   ; Address return MSB
R7>UL                   ;                LSB
JMP                     ; ***************************************************
ORG/1D00H               ; 3A00H  ROUTINE R0 - 1 > R0 (No Carry) Return R6:R7
DecRoutine:
R0-0>A                  ; NOT R0 > R0
NOT A-0
R0-1>A
NOT A-1
R0-2>A
NOT A-2
R0-3>A
NOT A-3
R0-4>A
NOT A-4
R0-5>A
NOT A-5
R0-6>A
NOT A-6
R0-7>A
NOT A-7
Q>R0
R0-0>A                  ; R0+1>R0
A>Q0
AND R0-1
Q1>A
AND R0-2
Q2>A
AND R0-3
Q3>A
AND R0-4
Q4>A
AND R0-5
Q5>A
AND R0-6
Q6>A
AND R0-7
Q>R1                    ; SAVE Cout into R1-7 (Not used)
Q6>A
XOR R0-7
