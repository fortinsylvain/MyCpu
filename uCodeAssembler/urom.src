; -----------------------------------------------------------------
; Homebrew CPU micro code
; Author: Sylvain Fortin  sylfortin71@hotmail.com
; Date : 6 march 2026
; Documentation : uCode stored in 2 binary file to be 
;                 programmed into 2864 to control the 74LSxx based 
;                 cpu.
; -----------------------------------------------------------------
; RAM / EEPROM address constants (plain addresses only; no UH/UL)
; -----------------------------------------------------------------
RAM_START     EQU 0000H ; 0000H - 17FFH Total RAM space
RAM_END       EQU 17FFH ; End of RAM space
STACK_START   EQU 00A0H ; 00A0H - 00FFH Stack
STACK_END     EQU 00FFH ; End of stack
RAM_FREE      EQU 0100H ; 0100H - 17EBH Free for application
RAM_FREE_END  EQU 17EBH ; End of application RAM
TEMP0         EQU 1FECH ; Temporary storage 0
TEMP1         EQU 1FEDH ; Temporary storage 1
TEMP2         EQU 1FEEH ; Temporary storage 2
TEMP3         EQU 1FEFH ; Temporary storage 3
SP            EQU 1FF0H ; Stack Pointer 8-bit
JSH           EQU 1FF1H ; Temporary storage for JSR MSB address
JSL           EQU 1FF2H ; Temporary storage for JSR LSB address
X_MSB         EQU 1FF3H ; X register MSB
X_LSB         EQU 1FF4H ; X register LSB
E_FLAG        EQU 1FFAH ; bit<0> Equal flag
C_FLAG        EQU 1FFBH ; bit<0> Carry flag
A_REG         EQU 1FFCH ; A register
IPH           EQU 1FFEH ; Instruction Pointer MSB
IPL           EQU 1FFFH ; Instruction Pointer LSB
LED_PORT      EQU C000H ; LED port
APP_EEPROM    EQU E000H ; EEPROM for application program
RESET_MSB     EQU FFFEH ; Reset vector MSB
RESET_LSB     EQU FFFFH ; Reset vector LSB
; -----------------------------------------------------------------
; Microcode address labels (these are true microcode targets and may use .UH/.UL)
; -----------------------------------------------------------------
ORG/0000H               ; 0000H   RESET
Reset:
00H>R1
00H>R0                  ; Dummy Instruction
STACK_START.LSB>R0      ; Stack Pointer Init
SP.MSB>AH               ; Stack Start : 00A0H
SP.LSB>AL               ; Stack Max   : 00FFH
R0>DATA
RESET_MSB.MSB>AH        ; Get [FFFE] MSB Start Vector
RESET_MSB.LSB>AL
DATA>R0
IPH.MSB>AH              ; MSB Start Vector Stored in IPH
IPH.LSB>AL
R0>DATA
RESET_LSB.MSB>AH        ; Get [FFFF] LSB Start Vector
RESET_LSB.LSB>AL
DATA>R1
IPL.MSB>AH              ; LSB Start Vector Stored in IPL
IPL.LSB>AL
R1>DATA 
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/0080H               ; 0100H Get Pointed OP Code by IP and Execute
OpExec:
IPH.MSB>AH              ; Read IPH
IPH.LSB>AL
DATA>R0
IPL.LSB>AL              ; Read IPL
DATA>R1                          
R0>AH                   ; Write IPH:IPL in AH:AL
R1>AL
DATA>R3                 ; Read OP. Code
IncIP.UH>UH             ;          | ADD. ROUTINE INCREMENT IP
IncIP.UL>UL             ;          |
OpExecAfterInc.UH>R4    ;  IP+1>IP | ADD. RETURN
OpExecAfterInc.UL>R5    ;  IP>ADD  |
JMP                     ;          | JMP TO ROUTINE
OpExecAfterInc:
R3>UH                   ; Build micro address and execute OP. code
00H>UL
JMP                     ; ***************************************************
ORG/0100H               ; 0200H Take Next OP Code and Execute
NextOpExec:
IncIP.UH>UH             ;          | ADD. ROUTINE INCREMENT IP
IncIP.UL>UL             ;          |
NextOpAfterInc.UH>R4    ;  IP+1>IP | ADD. RETURN
NextOpAfterInc.UL>R5    ;  IP>ADD  |
JMP                     ;          | JMP TO ROUTINE
NextOpAfterInc:
DATA>R3                 ; Read OP. Code
IncIP.UH>UH             ;          | ADD. ROUTINE INCREMENT IP
IncIP.UL>UL             ;          |
OpExecAfterInc.UH>R4    ;  IP+1>IP | ADD. RETURN
OpExecAfterInc.UL>R5    ;  IP>ADD  | JMP TO ROUTINE
JMP                     ; ***************************************************
ORG/0180H               ; OP.03 INCA  INCREMENT REGISTER A
A_REG.MSB>AH            ;             C not updated, E updated
A_REG.LSB>AL
DATA>R0                 ; READ REG. A
IncaReturn.UH>R6        ;
IncaReturn.UL>R7        ; R0+1>R0
IncrementR0.UH>UH       ; Cout>R1-7
IncrementR0.UL>UL
JMP
IncaReturn:
A_REG.MSB>AH            ; RESULT IN REG. A
A_REG.LSB>AL
R0>DATA
; R1-7>A              ; Carry bit stored in ALU input A
; A>Q0                ; Place Carry in bit position <0>
; 00H>R1              ; Put '0' in ALU input A
; R1-0>A
; A>Q1                ; Set Q<7:1> to 0
; A>Q2                ; To have a clean Carry Status Byte
; A>Q3
; A>Q4
; A>Q5
; A>Q6
; A>Q7
; Q>R0                ; Move Q byte in R0
; 1FH>AH              ; Store R0 in Carry Status RAM location
; FBH>AL
; R0>DATA
R0-0>A                  ; Update E (If result is zero then set E flag )
OR R0-1                 ; NOT( 7 OR 6 OR 5 OR 4 OR 3 OR 2 OR 1 OR 0 )
Q1>A
OR R0-2
Q2>A
OR R0-3
Q3>A
OR R0-4
Q4>A
OR R0-5
Q5>A
OR R0-6
Q6>A
OR R0-7
Q7>A
NOT A-0
00H>R1                  ; Set Q<7:1> to 0
R1-0>A                  ; To have a clean E Status Byte
A>Q1                   
A>Q2                   
A>Q3
A>Q4
A>Q5
A>Q6
A>Q7
Q>R1                    ; Move Q byte in R1
E_FLAG.MSB>AH           ; Store E in Equal Status RAM location
E_FLAG.LSB>AL
R1>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ******************************************************
ORG/0200H               ; OP.04 LDX #****H  Load Register X with 16 bits immediate
DATA>R2                 ; Take MSB Immediate value
IncIP.UH>UH             ;          | ADD. ROUTINE
IncIP.UL>UL             ;  IP+1>IP |
LdxImmLsb.UH>R4         ;  IP>ADD  | ADD. RETURN
LdxImmLsb.UL>R5         ;          |
JMP
LdxImmLsb:
DATA>R3                 ; Take LSB Immediate value
X_MSB.MSB>AH            ; Put MSB value into register X MSB
X_MSB.LSB>AL
R2>DATA
X_LSB.MSB>AH            ; Put LSB value into register X LSB
X_LSB.LSB>AL
R3>DATA
NextOpExec.UH>UH        ; NEXT OP.
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/0280H               ; OP.05 INCX  Increment Register X
X_LSB.MSB>AH            ;             Carry Not Updated
X_LSB.LSB>AL
DATA>R0                 ; Read Reg X LSB
IncxLsbReturn.UH>R6     ;
IncxLsbReturn.UL>R7     ; R0+1>R0
IncrementR0.UH>UH       ; Cout>R1-7
IncrementR0.UL>UL
JMP
IncxLsbReturn:
X_LSB.MSB>AH            ; Put increment result in REG. X LSB
X_LSB.LSB>AL
R0>DATA
R1-7>A                  ; Add 1 to X MSB only if there is a carry
OpExec.UH>UH            ; If Cout=0 no increment on X MSB
OpExec.UL>UL            ; and go execute currently pointed OP.
JMP_A=0                 
X_MSB.LSB>AL            ; If Cout=1 then we increment X MSB
DATA>R0                 ; Read X MSB
IncxMsbReturn.UH>R6     ; R0+1>R0
IncxMsbReturn.UL>R7     ; Cout>R1-7, go execute currently pointed OP.
IncrementR0.UH>UH                  
IncrementR0.UL>UL
JMP
IncxMsbReturn:
R0>DATA                 ; Store X MSB
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ******************************************************
ORG/0300H               ; OP.06 JSR    Jump to SubRoutine
DATA>R0                 ; Read MSB IP Destination
JSH.MSB>AH              ; Store in JSH (Temp SP1) MSB
JSH.LSB>AL
R0>DATA  
IncIP.UH>UH             ;          | ADD. ROUTINE INCREMENT IP
IncIP.UL>UL             ;          |
JsrLsbOperand.UH>R4     ;  IP+1>IP | ADD. RETURN
JsrLsbOperand.UL>R5     ;  IP>ADD  |
JMP                     ;          | JMP TO ROUTINE
JsrLsbOperand:
DATA>R0                 ; Read LSB IP Destination
JSL.MSB>AH              ; Store in JSL (Temp SP2) LSB
JSL.LSB>AL
R0>DATA
IncrementIp.UH>UH       ;  IP+1>IP | ADDRESS OF ROUTINE TO INCREMENT IP
IncrementIp.UL>UL       ;          | Compute return address from routine
JsrRetAddr.UH>R4        ;          | R4 R5 Add. Return for uProgram
JsrRetAddr.UL>R5
JMP
JsrRetAddr:
SP.MSB>AH               ; Read STACK POINTER Register (SP) (8bit LSB) MSB=0H Always
SP.LSB>AL
DATA>R0
IPH.LSB>AL              ; Read IPH Return Adress
DATA>R1
00H>AH                  ; Put in STACK
R0>AL
R1>DATA
SP.MSB>AH 
SP.LSB>AL
DATA>R0
IncrementR0.UH>UH       ; Increment R0 containing SP value
IncrementR0.UL>UL       ; R0+1>R0  | ADD. Incrementation Routine
06H>R6                  ;          | ADD. Return
22H>R7
JMP
R0>DATA                 ; Put Result in SP Register
IPL.LSB>AL              ; Read IPL for subroutine return
DATA>R1
00H>AH                  ; Put value of SP on address bus
R0>AL                   
R1>DATA                 ; Store IPL return on Stack
IncrementR0.UH>UH       ; Increment R0 containing SP value
IncrementR0.UL>UL       ; R0+1>R0  | ADD. Incrementation Routine
06H>R6                  ;          | ADD. Return
2DH>R7
JMP
SP.MSB>AH               ; Store new value in SP Register
SP.LSB>AL
R0>DATA
JSH.MSB>AH              ; Read JSH stored MSB address of routine to execute
JSH.LSB>AL
DATA>R0
IPH.LSB>AL              ; Write MSB address routine in IPH
R0>DATA
JSL.MSB>AH              ; Read JSL stored LSB address of routine to execute
JSL.LSB>AL
DATA>R0
IPL.LSB>AL              ; Write LSB address routine in IPL
R0>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/0380H               ; OP.07 RTS    ReTurn from Subroutine
SP.MSB>AH               ; Read Stack Pointer Register
SP.LSB>AL
DATA>R0
DecRoutine.UH>UH        ;          | ADD. Routine R0-1>R0
DecRoutine.UL>UL        ; SP-1     |
RtsLowReturn.UH>R6      ;          | ADD. return
RtsLowReturn.UL>R7      ; Decrementing the Stack Pointer Register
JMP
RtsLowReturn:
00H>AH                  ; Read from Stack return address IPL
R0>AL
DATA>R1
IPL.MSB>AH              ; Store in IPL Register
IPL.LSB>AL
R1>DATA
DecRoutine.UH>UH        ;          | ADD. Routine R0-1>R0
DecRoutine.UL>UL        ; SP-1     |
07H>R6                  ;          | ADD. return
13H>R7                  ; Again decrementing the Stack Pointer Register
JMP
SP.LSB>AL               ; Store in SP register
R0>DATA
00H>AH                  ; Read from Stack return address IPH
R0>AL
DATA>R1
IPH.MSB>AH              ; Store in IPH Register
IPH.LSB>AL
R1>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/0400H               ; OP.08 STOP   STOP MICROPROGRAM EXECUTION
StopLoop.UH>UH
StopLoop.UL>UL
StopLoop:
JMP                     ; ***************************************************
ORG/0480H               ; OP.09 NOP    No OPeration
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/0500H               ; OP.0A LDA (X) Load Reg A Indexed
X_MSB.MSB>AH            ; Read X MSB
X_MSB.LSB>AL
DATA>R2
X_LSB.LSB>AL            ; Read X LSB
DATA>R3
R2>AH                   ; Put on addres bus
R3>AL
DATA>R0                 ; Read pointed byte
A_REG.MSB>AH            ; Write in register A
A_REG.LSB>AL
R0>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/0580H               ; OP.0B STA (X) Store Reg A Indexed
X_MSB.MSB>AH            ; Read X MSB
X_MSB.LSB>AL
DATA>R2
X_LSB.LSB>AL            ; Read X LSB
DATA>R3
A_REG.LSB>AL            ; Read Reg A
DATA>R4
R2>AH                   ; Set address bus
R3>AL
R4>DATA                 ; Write
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/0600H               ; OP.0C JRA **H Unconditional relative jump
Jra:
DATA>R0                 ; Read the displacement
R0-7>A                  ; Check sign bit <7>
JraForward.UH>UH
JraForward.UL>UL
JMP_A=0                 ; if bit 7 is 0 then we jump foward,
IPL.MSB>AH              ; Else jump backward
IPL.LSB>AL              ; Read IPL
DATA>R1
01H>R2                  ; Put Cin(R2-0)=1
Add.UH>UH               ;           | ADD. ROUTINE
Add.UL>UL               ; R0+R1>R0  |
JraBackRet.UH>R6        ; Cout>R2-0 | RETURN ADDRESS
JraBackRet.UL>R7
JMP
JraBackRet:
R0>DATA                 ; Store IPL
IPH.LSB>AL              ; Read IPH
DATA>R0
FFH>R1                  ; Sign extension
Add.UH>UH               ; Cin(R2-0) | ADD. ROUTINE
Add.UL>UL               ; R0+R1>R0  |
JraBackHighRet.UH>R6    ; Cout>R2-0 | RETURN ADDRESS
JraBackHighRet.UL>R7
JMP
JraBackHighRet:
R0>DATA                 ; Store IPH
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP
ORG/0640H 
JraForward:
IPL.MSB>AH              ; Read IPL >>Jump forward arrive here<<
IPL.LSB>AL                  
DATA>R1
01H>R2                  ; Put Cin(R2-0)=1 to jump relative to next instruction
Add.UH>UH               ;           | ADD. ROUTINE
Add.UL>UL               ; R0+R1>R0  |
JraFwdRet.UH>R6         ; Cout>R2-0 | RETURN ADDRESS
JraFwdRet.UL>R7
JMP
JraFwdRet:
R0>DATA                 ; Store IPL
R2-0>A                  ; Add 1 to IPH only if there is a carry
OpExec.UH>UH            ; If Cout=0 no increment on IPH
OpExec.UL>UL            ; and go execute currently pointed OP.
JMP_A=0                 
IPH.LSB>AL              ; else Cout=1 then we increment IPH
DATA>R0                 ; Read IPH
IncrementR0.UH>UH       ; R0+1>R0
IncrementR0.UL>UL       ; Cout>R1-7
JraFwdHighRet.UH>R6     ; Return
JraFwdHighRet.UL>R7
JMP
JraFwdHighRet:
R0>DATA                 ; Store IPH
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/0680H               ; OP.0D SRLA   Shift Right Logical on Reg A
A_REG.MSB>AH            ;              0 -> b7 b6 b5 b4 b3 b2 b1 b0 -> C
A_REG.LSB>AL
DATA>R0                 ; Read A Register and store in R0
00H>R1                  ; Clear Register R1 to insert a '0' in bit 7
R1-0>A
A>Q7
R0-7>A                  ; shift bit 6:1 to 5:0, result in Q
A>Q6
R0-6>A
A>Q5
R0-5>A
A>Q4
R0-4>A
A>Q3
R0-3>A
A>Q2
R0-2>A
A>Q1
R0-1>A
A>Q0
Q>R2                    ; Transfer shifted result into R2
R2>DATA                 ; Store result in Register A
R1-0>A                  ; Clear Q[7:1]
A>Q7
A>Q6
A>Q5
A>Q4
A>Q3
A>Q2
A>Q1
R0-0>A                  ; Get bit 0 of original value before shifting
A>Q0                    ; b0 -> C
Q>R3                    ; Store Carry in R3
C_FLAG.LSB>AL           ; Save to the Carry Status Register
R3>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/0700H               ; OP.0E SLLA/SLAA  Shift Left Logical/Arithmetic on Reg A
A_REG.MSB>AH            ;              C <- b7 b6 b5 b4 b3 b2 b1 b0 <- 0
A_REG.LSB>AL
DATA>R0                 ; Read A Register and store in R0
00H>R1                  ; Clear Register R1 to insert a '0' in bit 0
R1-0>A
A>Q0
R0-0>A                  ; shift bit 6:0 to 7:1, result in Q
A>Q1
R0-1>A
A>Q2
R0-2>A
A>Q3
R0-3>A
A>Q4
R0-4>A
A>Q5
R0-5>A
A>Q6
R0-6>A
A>Q7
Q>R2                    ; Transfer shifted result into R2
R2>DATA                 ; Store result in Register A
R1-0>A                  ; Clear Q[7:1]
A>Q7
A>Q6
A>Q5
A>Q4
A>Q3
A>Q2
A>Q1
R0-7>A                  ; Get bit 7 of original value before shifting
A>Q0                    ; b7 -> C
Q>R3                    ; Store Carry in R3
C_FLAG.LSB>AL           ; Save to the Carry Status Register
R3>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/0780H               ; OP.0F JRNC
C_FLAG.MSB>AH           ; Read C bit and put in A ALU input
C_FLAG.LSB>AL
DATA>R0
R0-0>A
JrncTaken.UH>UH         ; if C = 0 then prepare the jump JRA
JrncTaken.UL>UL
JMP_A=0
NextOpExec.UH>UH        ; NEXT OP.
NextOpExec.UL>UL
JMP                     
JrncTaken:
IPH.LSB>AL              ; Put IP on Address Bus
DATA>R0
IPL.LSB>AL
DATA>R1
R0>AH
R1>AL
Jra.UH>UH               ; do the JRA
Jra.UL>UL
JMP                     ; ***************************************************
ORG/0800H               ; OP.10 RRCA Rotate Right Logical Reg A through Carry  
A_REG.MSB>AH            ;            C -> b7 b6 b5 b4 b3 b2 b1 b0 -> C
A_REG.LSB>AL
DATA>R0                 ; Read A Register and store in R0
C_FLAG.LSB>AL           ; Read Carry and put in R1
DATA>R1
R1-0>A                  ; Take Carry from Register R1 and insert in bit 7
A>Q7
R0-7>A                  ; shift bit 6:1 to 5:0, result in Q
A>Q6
R0-6>A
A>Q5
R0-5>A
A>Q4
R0-4>A
A>Q3
R0-3>A
A>Q2
R0-2>A
A>Q1
R0-1>A
A>Q0
Q>R2                    ; Store shifted result in R2
A_REG.LSB>AL            ; Store result in Register A
R2>DATA
00H>R3                  ; Clear Q[7:1]
R3-0>A                  
A>Q7
A>Q6
A>Q5
A>Q4
A>Q3
A>Q2
A>Q1
R0-0>A                  ; Get bit 0 of original value before shifting
A>Q0                    ; b0 -> C
Q>R4                    ; Store Carry in R4
C_FLAG.LSB>AL           ; Save to the Carry Status Register
R4>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/0880H               ; OP.11 RCF  Reset Carry Flag  Carry <- 0 
00H>R0                  ; clear all bits in R0
C_FLAG.MSB>AH           ; Write in carry satus bit
C_FLAG.LSB>AL
R0>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/0900H               ; OP.12 SCF  Set Carry Flag  Carry <- 1
01H>R0                  ; Set carry flag
C_FLAG.MSB>AH           ; Write in carry satus bit
C_FLAG.LSB>AL
R0>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/0980H               ; OP.13 DECXL  Decrement XL  E updated
X_LSB.MSB>AH            ; Read XL and put in R0
X_LSB.LSB>AL
DATA>R0
DecRoutine.UH>UH        ;          | ADD. Routine R0-1>R0
DecRoutine.UL>UL        ;          |
DecXlReturn.UH>R6       ;          | ADD. return
DecXlReturn.UL>R7       ; 
JMP
DecXlReturn:
R0>DATA                 ; Put result in XL
R0-0>A                  ; Update E (If result is zero then set E flag )
OR R0-1                 ; NOT( 7 OR 6 OR 5 OR 4 OR 3 OR 2 OR 1 OR 0 )
Q1>A
OR R0-2
Q2>A
OR R0-3
Q3>A
OR R0-4
Q4>A
OR R0-5
Q5>A
OR R0-6
Q6>A
OR R0-7
Q7>A
NOT A-0
00H>R1                  ; Set Q<7:1> to 0
R1-0>A                  ; To have a clean E Status Byte
A>Q1                   
A>Q2                   
A>Q3
A>Q4
A>Q5
A>Q6
A>Q7
Q>R1                    ; Move Q byte in R1
E_FLAG.LSB>AL           ; Store E in Equal Status RAM location
R1>DATA
OpExec.UH>UH            ; Get Pointed OP Code and Execute
OpExec.UL>UL
JMP                     ; ***************************************************
ORG/0A00H               ; OP.14 RRC ****H Rotate Right Logical Address through Carry  
DATA>R2                 ; READ MSB ADDRESS    C -> b7 b6 b5 b4 b3 b2 b1 b0 -> C
IncIP.UH>UH             ;          | ADD. ROUTINE INCREMENT IP
IncIP.UL>UL             ;          |
RrcLsbOperand.UH>R4     ;  IP+1>IP | ADD. RETURN
RrcLsbOperand.UL>R5     ;  IP>ADD  |
JMP                     ;          | JMP TO ROUTINE
RrcLsbOperand:
DATA>R3                 ; READ LSB ADDRESS
R2>AH                   ; PUT ADDRESS ON ADDRESS BUS
R3>AL
DATA>R0                 ; READ POINTED BYTE, put in R0
C_FLAG.MSB>AH           ; Read Carry and put in R1
C_FLAG.LSB>AL                  
DATA>R1
R1-0>A                  ; Take Carry from Register R1 and insert in bit 7
A>Q7
R0-7>A                  ; shift bit 6:1 to 5:0, result in Q
A>Q6
R0-6>A
A>Q5
R0-5>A
A>Q4
R0-4>A
A>Q3
R0-3>A
A>Q2
R0-2>A
A>Q1
R0-1>A
A>Q0
Q>R1                    ; Store shifted result in R1
R2>AH                   ; Store result in pointed byte
R3>AL
R1>DATA
00H>R2                  ; Clear Q[7:1]
R2-0>A                  
A>Q7
A>Q6
A>Q5
A>Q4
A>Q3
A>Q2
A>Q1
R0-0>A                  ; Get bit 0 of original value before shifting
A>Q0                    ; b0 -> C
Q>R4                    ; Store Carry in R4
C_FLAG.MSB>AH           ; Save to the Carry Status Register
C_FLAG.LSB>AL                  
R4>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/0A80H               ; OP.15 SRL ****H   Shift Right Logical on Address
DATA>R2                 ; READ MSB ADDRESS  0 -> b7 b6 b5 b4 b3 b2 b1 b0 -> C
IncIP.UH>UH             ;          | ADD. ROUTINE INCREMENT IP
IncIP.UL>UL             ;          |
SrlLsbOperand.UH>R4     ;  IP+1>IP | ADD. RETURN
SrlLsbOperand.UL>R5     ;  IP>ADD  |
JMP                     ;          | JMP TO ROUTINE
SrlLsbOperand:
DATA>R3                 ; READ LSB ADDRESS
R2>AH                   ; PUT ADDRESS ON ADDRESS BUS
R3>AL
DATA>R0                 ; READ POINTED BYTE, put in R0
00H>R1                  ; Clear Register R1 to insert a '0' in bit 7
R1-0>A
A>Q7
R0-7>A                  ; shift bit 6:1 to 5:0, result in Q
A>Q6
R0-6>A
A>Q5
R0-5>A
A>Q4
R0-4>A
A>Q3
R0-3>A
A>Q2
R0-2>A
A>Q1
R0-1>A
A>Q0
Q>R1                    ; Transfer shifted result into R1
R2>AH                   ; Store shifted value back to address
R3>AL
R1>DATA                 
00H>R1
R1-0>A                  ; Clear Q[7:1]
A>Q7
A>Q6
A>Q5
A>Q4
A>Q3
A>Q2
A>Q1
R0-0>A                  ; Get bit 0 of original value before shifting
A>Q0                    ; b0 -> C
Q>R0                    ; Store Carry in R0
C_FLAG.MSB>AH           ; Save to the Carry Status Register
C_FLAG.LSB>AL                  
R0>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/0B00H               ; OP.16 STX ****H   STORE X REGISTER TO ADDRESS
DATA>R3                 ; READ MSB ADDRESS
IncIP.UH>UH             ;          | ADD. ROUTINE INCREMENT IP
IncIP.UL>UL             ;          |
StxLsbOperand.UH>R4     ;  IP+1>IP | ADD. RETURN
StxLsbOperand.UL>R5     ;  IP>ADD  |
JMP                     ;          | JMP TO ROUTINE
