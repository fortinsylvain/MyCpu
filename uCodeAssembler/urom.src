OpExec.UL>UL
JMP                     ; ***************************************************
ORG/0F80H               ; OP.1F CMPA ****H Compare A with direct-addressed byte, E and C update
DATA>R2                 ; Read MSB Address (MSB->R2)          
IncIP.UH>UH             ;          | ADD. ROUTINE INCREMENT IP
IncIP.UL>UL             ;          |
CmpaDirOpLsb.UH>R4      ;  IP+1>IP | ADD. RETURN
CmpaDirOpLsb.UL>R5      ;  IP>ADD  |
JMP                     ;          | JMP TO ROUTINE
CmpaDirOpLsb:
DATA>R3                 ; Read LSB Address (LSB->R3)
R2>AH                   ; Put address on the address bus
R3>AL
DATA>R1                 ; Read the memory operand (Operand->R1)
A_REG.MSB>AH            ; Fetch register A (A->R0)
A_REG.LSB>AL   
DATA>R0
00H>R2                  ; Two's complement of immediate (R1 = ~R1)
R2-0>A                  ; Clear ALU A
XNOR R1-0
XNOR R1-1
XNOR R1-2
XNOR R1-3
XNOR R1-4
XNOR R1-5
XNOR R1-6
XNOR R1-7
Q>R1
01H>R2                  ; R2-0 used as Cin
Add.UH>UH               ; Cin:R2-0  | ADD. ROUTINE
Add.UL>UL               ; R0+R1>R0  |
CmpaDirRet.UH>R6        ; Cout>R2-0 | RETURN ADDRESS
CmpaDirRet.UL>R7        ; keep carry out R2
JMP
CmpaDirRet:
C_FLAG.MSB>AH           ; Save C
C_FLAG.LSB>AL
R2>DATA
R0-0>A                  ; Check R0 equal 0
OR R0-1
Q1>A
OR R0-2
Q2>A
OR R0-3
Q3>A
OR R0-4
Q4>A
OR R0-5
Q5>A
OR R0-6
Q6>A
OR R0-7
Q7>A
CmpaDirNotEq.UH>UH
CmpaDirNotEq.UL>UL
JMP_A=1                 ; if any bit is 1 jump
01H>R1                  ; E=1, Result is equal to 0
E_FLAG.LSB>AL   
R1>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP
CmpaDirNotEq:
00H>R1                  ; E=0, Result is not 0
E_FLAG.LSB>AL   
R1>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
ORG/1000H               ; OP.20 DECA  Decrement REGISTER A
A_REG.MSB>AH            ;             C not updated, E updated
A_REG.LSB>AL
DATA>R0                 ; READ REG. A
