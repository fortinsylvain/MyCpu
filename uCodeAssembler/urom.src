DATA>R0                 ; Read LSB Operand
X_LSB.MSB>AH            ; Read XL
X_LSB.LSB>AL
DATA>R1
00H>R2                  ; Clear carry in
Add.UH>UH               ; Cin:R2-0  | ADD. ROUTINE
Add.UL>UL               ; R0+R1>R0  |
StaIdxLowRet.UH>R6      ; Cout>R2-0 | RETURN ADDRESS
StaIdxLowRet.UL>R7      ; keep carry in R2 it will be used later
JMP
StaIdxLowRet:
TEMP1.LSB>AL            ; store LSB address summ in TEMP1
R0>DATA                 
TEMP0.LSB>AL            ; Load MSB Operand from TEMP0
DATA>R0
X_MSB.MSB>AH            ; Read XH
X_MSB.LSB>AL                  
DATA>R1
Add.UH>UH               ; Cin:R2-0  | ADD. ROUTINE
Add.UL>UL               ; R0+R1>R0  |
StaIdxHighRet.UH>R6     ; Cout>R2-0 | RETURN ADDRESS
StaIdxHighRet.UL>R7
JMP
StaIdxHighRet:
TEMP1.LSB>AL            ; MSB Address is in R0
DATA>R1                 ; LSB Address is in TEMP1 put it in R1
A_REG.MSB>AH            ; Read Data from Register A
A_REG.LSB>AL
DATA>R2
R0>AH                   ;  Store Data to specifyed resulting address
R1>AL
R2>DATA
NextOpExec.UH>UH        ; NEXT OP.    
NextOpExec.UL>UL
JMP                     ; ***************************************************
