DATA>R2                 ; READ LSB ADDRESS
X_MSB.MSB>AH            ; READ XH
X_MSB.LSB>AL
DATA>R4
R3>AH                   ; PUT ADDRESS ON ADDRESS BUS
R2>AL
R4>DATA                 ; Store XH and increment Storage address (R3:R2)
R2-0>A
A>Q0                    ; Compute the Carrys
AND R2-1
Q1>A
AND R2-2
Q2>A
AND R2-3
Q3>A
AND R2-4
Q4>A
AND R2-5
Q5>A
AND R2-6
Q6>A
AND R2-7
