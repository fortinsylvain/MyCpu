DIAGLOOPCOUNTER_MSB 01E0
DIAGLOOPCOUNTER_LSB 01E1
DIAGTST_MSB         01E2
DIAGTST_LSB         01E3
DIAGTST2_MSB        1EFF
DIAGTST2_LSB        1F00
UARTPORT            7400
LEDPORT             7800
LCD_CMD             7C00
LCD_DATA            7C01
START               8000
TX_LOOP             8005
UART_TX             8016
Assembly complete
